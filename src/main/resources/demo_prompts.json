      "description": "design a full adder with inputs a, b and cin; outputs sum and carry",
      "answer": {
        "summary": "Full adder with sum and carry outputs.",
        "inputs": [
          "A",
          "B",
          "Cin"
        ],
        "outputs": [
          {
            "name": "Sum",
            "expression": "A ^ B ^ Cin"
          },
          {
            "name": "Carry",
            "expression": "(A & B) | (Cin & (A ^ B))"
          }
        ],
        "truthTable": [
          {
            "output": "Sum",
            "bits": "01101001"
          },
          {
            "output": "Carry",
            "bits": "00010111"
          }
        ]
      }
    },
    {
      "description": "design a 2-bit comparator with greater-than, equal and less-than outputs",
      "answer": {
        "summary": "Unsigned 2-bit magnitude comparator.",
        "inputs": [
          "A1",
          "B1",
          "A0",
          "B0"
        ],
        "outputs": [
          {
            "name": "GT",
            "expression": "(A1 & !B1) | ((A1 XNOR B1) & A0 & !B0)"
          },
          {
            "name": "EQ",
            "expression": "(A1 XNOR B1) & (A0 XNOR B0)"
          },
          {
            "name": "LT",
            "expression": "(!A1 & B1) | ((A1 XNOR B1) & !A0 & B0)"
          }
        ],
        "truthTable": [
          {
            "output": "GT",
            "bits": "0010000011110010"
          },
          {
            "output": "EQ",
            "bits": "1001000000001001"
          },
          {
            "output": "LT",
            "bits": "0100111100000100"
          }
        ]
      }
    },
